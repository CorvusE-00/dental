# Set this only to the approved public clinic origin before a production deployment.
# Local preview intentionally falls back to http://localhost:3001 and remains noindex.
NEXT_PUBLIC_SITE_URL=
# Server-only n8n transport endpoint. Configure this outside the repository.
N8N_CHAT_WEBHOOK_URL=
# Server-only shared secret sent to n8n as X-Luma-Secret. Never expose as NEXT_PUBLIC_.
N8N_CHAT_SECRET=
